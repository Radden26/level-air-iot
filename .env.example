# ROOT .env.example — copy ke dashboard/.env.local
# Firebase Realtime Database Config (Project Settings > SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=monitoring-level-air-xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://monitoring-level-air-xxxxx-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=monitoring-level-air-xxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=monitoring-level-air-xxxxx.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
NEXT_PUBLIC_TANK_PATH=/tanks/tangki1

# ESP32 Master — isi di esp32-master/src/main.cpp sebelum upload
